@model ProcureFlowX.Models.ProductModel

<h2>Product Details</h2>

<div class="card p-4">
    <p><b>Item:</b> @Model.ProductName</p>
    <p><b>Price:</b> @Model.UnitPrice</p>
    <p><b>Available Qty:</b> @Model.StockQty</p>
    <p><b>Status:</b> @(Model.IsActive ? "Active" : "Inactive")</p>

    <a href="@Url.Action("Edit", new { id = Model.ProductId })" class="btn btn-warning">Edit</a><br />
    <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
</div>