@model ProcureFlowX.Models.ProductModel

<h2>Add Product</h2>

@using (Html.BeginForm())
{
    <div class="card p-4">

        <label>Supplier</label>
        @Html.DropDownListFor(m => m.SupplierId,
            (SelectList)ViewBag.SupplierList,
            "-- Select Supplier --",
            new { @class = "form-control", required = "required" })

        <label class="mt-2">Product Name</label>
        @Html.TextBoxFor(m => m.ProductName,
            new { @class = "form-control", maxlength = "25", required = "required" })

        <label class="mt-2">Unit Price</label>
        @Html.TextBoxFor(m => m.UnitPrice,
            new { @class = "form-control", type = "number", step = "0.01", required = "required" })

        <label class="mt-2">Available Quantity</label>
        @Html.TextBoxFor(m => m.StockQty,
            new { @class = "form-control", type = "number", required = "required" })

        <br />
        <button class="btn btn-success">Save</button><br />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
    </div>
}