@model ProcureFlowX.Models.SupplierModel
@{
    ViewBag.Title = "Edit Supplier";
}

<h2>Edit Supplier</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.SupplierId)

    <div class="card p-4">

        <div class="mb-3">
            <label>Name</label>
            @Html.TextBoxFor(m => m.SupplierName, new { @class = "form-control", maxlength = "25", required = "required" })
        </div>

        <div class="mb-3">
            <label>Contact Number</label>
            @Html.TextBoxFor(m => m.ContactNumber, new
            {
                @class = "form-control",
                maxlength = "10",
                pattern = "[0-9]{10}",
                required = "required"
            })
        </div>

        <div class="mb-3">
            <label>Email</label>
            @Html.TextBoxFor(m => m.EmailAddress, new
            {
                @class = "form-control",
                type = "email",
                required = "required"
            })
        </div>

        <div class="mb-3">
            <label>Address</label>
            @Html.TextBoxFor(m => m.SupplierAddress, new
            {
                @class = "form-control",
                maxlength = "30",
                required = "required"
            })
        </div>

        <div class="mb-3">
            <label>Status</label>
            @Html.DropDownListFor(m => m.IsActive,
                new SelectList(new[]
                {
                    new { Value = true, Text = "Active" },
                    new { Value = false, Text = "Inactive" }
                }, "Value", "Text"),
                new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-primary">Update</button><br />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
    </div>
}