@model ProcureFlowX.Models.GoodsReceiptModel

<h2 class="text-center mb-3">Goods Receipt Details</h2>

<!-- ✅ DOWNLOAD BUTTON (TOP RIGHT) -->
<div style="text-align:right; margin-bottom:10px;">
    <button onclick="downloadPDF()" class="btn btn-primary">
        Download Receipt (PDF)
    </button>
</div>

<div id="receiptContent">

    <div class="card p-4 mb-4">
        <h5>Supplier Information</h5>
        <p><b>Name:</b> @Model.SupplierName</p>
        <p><b>Contact:</b> @Model.ContactNumber</p>
        <p><b>Address:</b> @Model.SupplierAddress</p>
        <p><b>GRN Date:</b> @Model.GRNDate.ToString("dd-MMM-yyyy")</p>
        <p><b>Status:</b> @Model.GRNStatus</p>
    </div>

    <div class="card p-4">
        <h5>Item Details</h5>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Rate</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    decimal grandTotal = 0;
                }
                @foreach (var i in Model.Items)
                {
                    grandTotal += i.LineTotal;
                    <tr>
                        <td>@i.ProductName</td>
                        <td>@i.ReceivedQty</td>
                        <td>@i.UnitRate</td>
                        <td>@i.LineTotal</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Grand Total</th>
                    <th>@grandTotal</th>
                </tr>
            </tfoot>
        </table>
    </div>

</div>

<a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back</a>

<!-- ✅ LIBRARY -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<!-- ✅ DOWNLOAD SCRIPT -->
<script>
    function downloadPDF() {

        var element = document.getElementById("receiptContent");

        var opt = {
            margin: 0.5,
            filename: 'Purchase_Order.pdf',
            image: { type: 'jpeg', quality: 1 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(element).save();
    }
</script>